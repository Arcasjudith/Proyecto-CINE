        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Inicio([Módulo: Administrador]) --&gt; MenuAdmin{Menú de Gestión}\n\n    %% Agregar Película\n    MenuAdmin -- Opción 1: Agregar --&gt; A1{¿Total Películas\\n&gt;= MAX_PELICULAS?}\n    A1 -- Sí --&gt; A1Err[Mostrar Error: Catálogo Lleno]\n    A1 -- No --&gt; A1Ask[/Solicitar: Título, Género, Duración, Horario/]\n    A1Ask --&gt; A1Save[Crear struct Pelicula y setear activo = true]\n    A1Save --&gt; A1Seats[Inicializar arreglo de Asientos de esta película]\n    A1Seats --&gt; A1Sum[Aumentar contador total_peliculas + 1]\n\n    %% Eliminar Película\n    MenuAdmin -- Opción 2: Eliminar --&gt; A2[/Ingresar Título a dar de baja/]\n    A2 --&gt; A2Find{¿Se encontró el título?}\n    A2Find -- No --&gt; A2Err[Mostrar Error: No existe]\n    A2Find -- Sí --&gt; A2Logic[Borrado Lógico:\\nCambiar pelicula.activo = false]\n\n    %% Modificar Película\n    MenuAdmin -- Opción 3: Modificar --&gt; A3[/Ingresar Título a modificar/]\n    A3 --&gt; A3Find{¿Se encontró y\\nestá activa?}\n    A3Find -- No --&gt; A3Err[Mostrar Error: No existe]\n    A3Find -- Sí --&gt; A3Menu{Sub-menú de Edición}\n    \n    A3Menu -- Opciones 1 a 4 --&gt; A3Edit[Sobrescribir: Título, Género, Duración u Horario]\n    A3Edit --&gt; A3Menu\n    A3Menu -- Opción 5: Volver --&gt; MenuAdmin\n\n    %% Volver y retornos\n    MenuAdmin -- Opción 4: Salir --&gt; FinAdmin([Volver al Menú Principal])\n\n    A1Err --&gt; MenuAdmin\n    A1Sum --&gt; MenuAdmin\n    A2Err --&gt; MenuAdmin\n    A2Logic --&gt; MenuAdmin\n    A3Err --&gt; MenuAdmin&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="grb71z5J0-D7VQlYaqjp-44">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

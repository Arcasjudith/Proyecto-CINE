  <diagram name="Página-1" id="nWK3Hj1N5ErKoFDbKZij">
    <mxGraphModel dx="1330" dy="576" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% BLOQUE 1: INICIALIZACIÓN\n    %% ==========================================\n    subgraph Fase 1 : Inicialización de la Sala\n        I1([Creación de nueva película]) --&gt; I2[Llamar a inicializar_sala]\n        I2 --&gt; I3[Bucle: Recorrer asientos del índice 0 al 49]\n        I3 --&gt; I4[Calcular Fila: índice / COLUMNAS]\n        \n        I4 --&gt; I5{determinar_color_por_fila:\\n¿En qué fila está?}\n        \n        I5 -- \&quot;Fila 0 (A)\&quot; --&gt; I6[Guardar COLOR_PREMIUM\\nVerde]\n        I5 -- \&quot;Filas 1 y 2 (B, C)\&quot; --&gt; I7[Guardar COLOR_MEDIA\\nAmarillo]\n        I5 -- \&quot;Filas 3 y 4 (D, E)\&quot; --&gt; I8[Guardar COLOR_GENERAL\\nAzul]\n        \n        I6 --&gt; I9\n        I7 --&gt; I9\n        I8 --&gt; I9\n        \n        I9{¿Faltan asientos?} -- Sí --&gt; I3\n        I9 -- No --&gt; I10([Sala coloreada y lista])\n    end\n\n    %% ==========================================\n    %% BLOQUE 2: ASIGNACIÓN Y COMPRA\n    %% ==========================================\n    subgraph Fase 2 : Reserva y Cambio de Color\n        V1([Usuario elige comprar asientos]) --&gt; V2[/Ingresa número de asiento (1-50)/]\n        V2 --&gt; V3[buscar_indice_asiento:\\nConvierte número de 1-50 a índice de 0-49\\nusando Búsqueda Binaria]\n        \n        V3 --&gt; V4{esta_asiento_ocupado:\\n¿El color actual es idéntico\\nal COLOR_RESERVADO?}\n        \n        V4 -- Sí (Rojo) --&gt; V5[Mostrar Error:\\nEl asiento está ocupado]\n        V5 --&gt; V2\n        \n        V4 -- No (Verde, Amarillo o Azul) --&gt; V6[Asiento Válido]\n        V6 --&gt; V7[Sobrescribir el color del asiento\\ncon COLOR_RESERVADO Rojo]\n        V7 --&gt; V8[Restar 1 al contador de asientos_libres]\n        V8 --&gt; V9([Asiento asignado con éxito])\n    end\n\n    %% ==========================================\n    %% BLOQUE 3: DIBUJO EN CONSOLA\n    %% ==========================================\n    subgraph Fase 3 : Renderizado Visual (mostrar_sala)\n        R1([Se solicita refrescar la pantalla]) --&gt; R2[Bucle: Evaluar cada asiento de la matriz]\n        \n        R2 --&gt; R3{esta_asiento_ocupado:\\n¿Color == Rojo?}\n        \n        R3 -- Sí --&gt; R4[/Imprimir bloque visual ROJO\\ncon texto &#39;XX&#39;/]\n        R3 -- No --&gt; R5[/Imprimir bloque visual con su\\nCOLOR ORIGINAL y número correlativo/]\n        \n        R4 --&gt; R6\n        R5 --&gt; R6\n        \n        R6{¿Terminó de leer\\nlos 50 asientos?}\n        R6 -- No --&gt; R2\n        R6 -- Sí --&gt; R7([Fin del dibujo en pantalla])\n    end\n\n    %% Conexiones invisibles para ordenar el diagrama en draw.io\n    I10 ~~~ V1\n    V9 ~~~ R1&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="o6mFOIekgPbQjuC5vxcb-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
